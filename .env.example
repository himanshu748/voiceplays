# Local testing: any client sends this as a bearer token. openssl rand -hex 32
VOICEPLAYS_TOKEN=

# Alexa+ (OAuth client_credentials). Set all three together.
VOICEPLAYS_CLIENT_ID=
VOICEPLAYS_CLIENT_SECRET=
# Public HTTPS origin that reaches this server, no trailing slash
PUBLIC_URL=

# Comma-separated play names. Empty by default.
# Plays not tagged effect-read-only that may run by voice (still need a spoken confirmation code)
VOICEPLAYS_ALLOW_WRITES=
# Registry plays you have reviewed; the server passes rote --yes for these only
VOICEPLAYS_APPROVED_REGISTRY=

PORT=8787
HOST=127.0.0.1
JOB_TIMEOUT_MS=900000
MAX_RUNNING=3
