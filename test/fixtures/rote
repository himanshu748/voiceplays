# Stand-in for the rote CLI so tests run without a real rote install.
if [ "$1 $2" = "play list" ]; then
  cat <<'JSON'
[
  {"name":"disk-space","description":"Report free disk space","tags":["effect-read-only","system"],"source":"local"},
  {"name":"disk-space","description":"Report free disk space","tags":["effect-read-only","system"],"source":"hub"},
  {"name":"restart-nginx","description":"Restart the web server","tags":["ops"],"source":"local"},
